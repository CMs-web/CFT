{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "1:1 chat backend with PostgreSQL and Firebase Firestore",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "lint:fix": "eslint src test scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run format:check",
    "smoke": "node scripts/smoke-test.mjs",
    "emulator": "firebase emulators:start --only firestore --project demo-chat"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
